{
  "name": "Novel",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "web": "webpack serve --config webpack.config.js",
    "test": "jest",
    "harness:refresh": "node scripts/harness-refresh.js",
    "harness:check": "node scripts/harness-check.js",
    "novel-design:audit": "node scripts/novel-design-audit.js generate",
    "novel-design:audit:check": "node scripts/novel-design-audit.js check",
    "novel-design:tokens": "node scripts/novel-design-token-build.js generate",
    "novel-design:tokens:check": "node scripts/novel-design-token-build.js check",
    "novel-design:assets": "node scripts/novel-design-assets.js generate",
    "novel-design:assets:check": "node scripts/novel-design-assets.js check",
    "stage7:closeout": "node scripts/stage7-closeout-readiness.js generate",
    "stage7:closeout:check": "node scripts/stage7-closeout-readiness.js check",
    "stage7:signoff:check": "node scripts/stage7-signoff-check.js",
    "version:show": "node scripts/version-sync.js show",
    "version:patch": "node scripts/version-sync.js patch",
    "version:minor": "node scripts/version-sync.js minor",
    "version:major": "node scripts/version-sync.js major",
    "version:sync": "node scripts/version-sync.js sync",
    "build:android": "npm run version:patch && cd android && ./gradlew assembleRelease",
    "build:android:bundle": "npm run version:patch && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@babel/preset-react": "^7.27.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.17",
    "babel-loader": "^10.0.0",
    "html-webpack-plugin": "^5.6.3",
    "immer": "^10.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "^3.17.4",
    "react-native-super-grid": "^6.0.1",
    "react-native-svg": "^15.8.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.20.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.2",
    "@react-native/eslint-config": "0.79.2",
    "@react-native/metro-config": "0.79.2",
    "@react-native/typescript-config": "0.79.2",
    "@svgr/webpack": "^8.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.0.0",
    "sass-loader": "^16.0.5",
    "typescript": "5.0.4",
    "webpack": "^5.99.9"
  },
  "engines": {
    "node": ">=18"
  }
}
